# Base URL of a deployed and reachable EcoQuest API (not a Neon database URL).
# The API service must be deployed separately from this Expo app.
EXPO_PUBLIC_API_URL=https://ecoquest.discloud.app

# OAuth 2.0 Web client ID. Use the same ID as GOOGLE_CLIENT_ID on the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native OAuth 2.0 client IDs from the same Google Cloud project (required on device).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
