# Local development defaults only. Replace these before deploying.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SQL_ECHO=false

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=72

# Comma-separated Google OAuth client IDs. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=
DEV_LOGIN=true
MODERATOR_EMAILS=

MAX_REVIEW_ROUNDS=3
PASS_PERCENT=30
DISPUTE_DELTA=30
TRUST_WINDOW=10
TRUST_THRESHOLD=0.4
TRUST_MIN_DECISIONS=5
RESET_TOKEN_MINUTES=60
RESET_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# mock is suitable for local demos; use gemini with a private key for AI review.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=30

MAX_PHOTO_MB=8
CORS_ORIGINS=*
